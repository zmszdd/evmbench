pragma solidity ^0.8.20;
import {MockERC20} from "./MockERC20.sol"; import {MockQuoter} from "./MockQuoter.sol"; import {MockSwapRouter} from "./MockSwapRouter.sol"; import {SharwaLending} from "./SharwaLending.sol"; import {UniswapModuleWithoutChainlink} from "contracts/modularSwapRouter/uniswap/UniswapModuleWithoutChainlink.sol";
contract Scenario { MockERC20 public usdc; MockERC20 public usdcE; MockQuoter public quoter; MockSwapRouter public swapRouter; UniswapModuleWithoutChainlink public module; SharwaLending public lending; uint256 public constant VAULT_SEED=1_000_000 ether;
 constructor(){ usdc=new MockERC20("USD Coin","USDC",0); usdcE=new MockERC20("USD Coin bridged","USDC.e",0); usdc.mint(address(this),VAULT_SEED); usdcE.mint(address(this),VAULT_SEED); quoter=new MockQuoter(1e18); swapRouter=new MockSwapRouter(address(usdc),address(usdcE),1e18); module=new UniswapModuleWithoutChainlink(address(this),address(usdc),500,address(usdcE),swapRouter,quoter); lending=new SharwaLending(address(module),address(usdc),1 ether); usdc.transfer(address(lending),VAULT_SEED); }
 function usdcAddress() external view returns(address){return address(usdc);} function quoterAddress() external view returns(address){return address(quoter);} function lendingAddress() external view returns(address){return address(lending);} function moduleAddress() external view returns(address){return address(module);} function victimFunds() external view returns(uint256){return usdc.balanceOf(address(lending));} }
